
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ABC College of Excellence</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #f4f7fb;
    color: #222;
}

/* Navigation */
header {
    background: #102b50;
    color: white;
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 10px;
    font-size: 14px;
}

nav a:hover {
    color: #ffc857;
}

/* Banner */
.banner {
    min-height: 420px;
    background: linear-gradient(120deg, #102b50, #1877a5);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
}

.banner h1 {
    font-size: 42px;
    margin-bottom: 18px;
}

.banner p {
    font-size: 18px;
    margin-bottom: 25px;
}

.btn {
    background: #ffc857;
    color: #102b50;
    padding: 13px 25px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

/* Sections */
section {
    padding: 55px 8%;
}

.section-title {
    text-align: center;
    color: #102b50;
    font-size: 30px;
    margin-bottom: 30px;
}

/* About */
.about {
    text-align: center;
    line-height: 1.8;
    max-width: 950px;
    margin: auto;
}

/* Cards */
.card-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.card {
    background: white;
    padding: 25px;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 3px 12px #00000015;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-7px);
}

.card h3 {
    color: #1877a5;
    margin: 12px 0;
}

.card p {
    line-height: 1.6;
    font-size: 14px;
}

.icon {
    font-size: 42px;
}

/* Admissions */
.admission {
    background: #e6f1fa;
    text-align: center;
    line-height: 2;
}

/* Events */
.event {
    border-left: 4px solid #1877a5;
    text-align: left;
}

/* Contact */
.contact {
    background: #102b50;
    color: white;
    text-align: center;
    line-height: 2;
}

.contact h2 {
    color: #ffc857;
}

/* Footer */
footer {
    background: #091a30;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Responsive */
@media(max-width: 768px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        text-align: center;
    }

    nav a {
        display: inline-block;
        margin: 7px;
    }

    .banner h1 {
        font-size: 30px;
    }

    section {
        padding: 40px 5%;
    }
}
</style>
</head>

